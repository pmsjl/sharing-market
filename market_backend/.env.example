SPRING_PROFILES_ACTIVE=prod
# The container defaults to 8081; a platform-provided PORT overrides it.
SERVER_ADDRESS=0.0.0.0

DB_URL=jdbc:mysql://mysql.example.internal:3306/trade?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-redis-password
REDIS_SSL_ENABLED=true

OSS_ACCESS_KEY=replace-with-oss-access-key
OSS_SECRET_KEY=replace-with-oss-secret-key
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=replace-with-bucket-name
OSS_HOST=https://assets.example.com

AI_AGENT_BASE_URL=https://agent.example.com
AI_AGENT_INTERNAL_TOKEN=replace-with-the-same-long-random-token-used-by-python
AI_AGENT_CONNECT_TIMEOUT_MS=5000
AI_AGENT_READ_TIMEOUT_MS=120000
AI_AGENT_PENDING_TIMEOUT_MS=140000

CORS_ALLOWED_ORIGIN_PATTERNS=https://market.example.com,https://preview.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none
API_DOCS_ENABLED=false
