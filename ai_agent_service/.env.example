# FastAPI 服务监听地址；云平台通常直接注入 PORT。
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8103
FORWARDED_ALLOW_IPS=*

# 必须与 Java 环境变量 AI_AGENT_INTERNAL_TOKEN 保持一致；不要提交真实值。
AI_AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token

# Java 服务根地址不要包含 /api；必须与 Java 的公开/内部可达地址一致。
JAVA_BACKEND_BASE_URL=https://api.your-domain.example
JAVA_BACKEND_TIMEOUT_SECONDS=10
AI_MAX_TOOL_ROUNDS=4

# OpenAI Responses 兼容中转配置；Base URL 必须包含 /v1。
# 密钥仅放本机环境变量或未跟踪 .env 文件。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-relay.example/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium

# 混合式意图 Router；默认直接启用。模型为空时由代码默认复用 OPENAI_MODEL。
INTENT_ROUTER_ENABLED=true
OPENAI_ROUTER_MODEL=gpt-5.6-terra
OPENAI_ROUTER_TIMEOUT_SECONDS=45
OPENAI_ROUTER_REASONING_EFFORT=low
OPENAI_ROUTER_TEXT_VERBOSITY=low
INTENT_ROUTER_CONFIDENCE_THRESHOLD=0.75

# RAG Embedding 独立配置；不要复用不支持 /embeddings 的生成模型中转。
# Base URL 只填写到 /v1，客户端会自动追加 /embeddings。
EMBEDDING_BASE_URL=https://your-workspace.example/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# 必须不超过所选模型的单次输入数量限制。
EMBEDDING_BATCH_SIZE=10

RAG_ENABLED=false
RAG_INDEX_DIR=.cache/rag_index
RAG_GUIDE_TOP_K=5
RAG_SCORE_THRESHOLD=0.50
RAG_GUIDE_MAX_CHUNKS_PER_DOCUMENT=2
RAG_POST_TOP_K=3
RAG_COURSE_AUXILIARY_POST_TOP_K=3
RAG_POST_SCORE_THRESHOLD=0.50
RAG_POST_MAX_CHUNKS_PER_DOCUMENT=1
# Java 快照接口允许 1..200；离线重建默认按最大页读取。
RAG_POST_SNAPSHOT_PAGE_SIZE=200
