# FastAPI 服务监听地址
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8103

# 必须与 Java 环境变量 AI_AGENT_INTERNAL_TOKEN 保持一致；不要提交真实值。
AI_AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token

# DeepSeek OpenAI 兼容接口配置；密钥仅放本机环境变量或未跟踪 .env 文件。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
